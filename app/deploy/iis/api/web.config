<?xml version="1.0" encoding="utf-8"?>
<!-- Plantilla para la carpeta /api (subaplicación). Rellena los valores y NO la subas a git con ellos. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Los errores del API (JSON) pasan tal cual; sin esto el panel los cambia por su HTML -->
      <httpErrors existingResponse="PassThrough" />
      <aspNetCore processPath=".\VontCasa.Api.exe" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="ConnectionStrings__Default" value="Server=TU_SERVIDOR,1433;Database=notvont;User Id=TU_USUARIO;Password=TU_PASSWORD;TrustServerCertificate=True;Encrypt=True" />
          <environmentVariable name="Security__JwtKey" value="openssl rand -base64 48" />
          <environmentVariable name="Security__EncryptionKey" value="openssl rand -base64 32" />
          <environmentVariable name="Cors__Origins__0" value="https://tu-dominio.com" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
