# Copia este archivo a .env y rellena los valores (NO lo subas a git).

# Cadena de conexión a TU SQL Server
CONNECTION_STRING=Server=TU_SERVIDOR,1433;Database=notvont;User Id=TU_USUARIO;Password=TU_PASSWORD;TrustServerCertificate=True;Encrypt=True

# Claves (genera unas nuevas para prod):
#   JWT_KEY:        openssl rand -base64 48
#   ENCRYPTION_KEY: openssl rand -base64 32   (debe decodificar a 32 bytes)
JWT_KEY=
ENCRYPTION_KEY=

# Dominio público (apuntando a la IP del VPS). Caddy saca el certificado HTTPS solo.
DOMAIN=casa.tudominio.com
